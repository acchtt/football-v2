# Live football provider.
DATA_PROVIDER=bsd
BSD_API_BASE_URL=https://sports.bzzoiro.com/api/v2
BSD_API_TOKEN=
BSD_HISTORY_MATCHES=10
BSD_LOOKBACK_DAYS=180

# Authoritative PRE ranking. Without this key the live board fails closed instead of showing the retrieval proxy.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol

# Later integration
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
