# Database
POSTGRES_DB=football_v2
POSTGRES_USER=football
POSTGRES_PASSWORD=football_local_only
DATABASE_URL=postgresql+psycopg://football:football_local_only@db:5432/football_v2

# API
APP_ENV=development
FIXTURE_PROVIDER=demo
SEED_DEMO_ON_READ=true
WEB_ORIGIN=http://localhost:3000
VISION_PROVIDER=demo
VISION_MODEL=gpt-5.6
OPENAI_API_KEY=
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=6

# Web (server-side URL used by Next.js)
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
