# Database
POSTGRES_DB=football_v2
POSTGRES_USER=football
POSTGRES_PASSWORD=football_local_only
DATABASE_URL=postgresql+psycopg://football:football_local_only@db:5432/football_v2

# API
APP_ENV=development
FIXTURE_PROVIDER=demo
SEED_DEMO_ON_READ=true
BSD_API_TOKEN=
BSD_BASE_URL=https://sports.bzzoiro.com/api/v2
BSD_TIMEOUT_SECONDS=20
BSD_HISTORY_MATCHES=10
BSD_LOOKBACK_DAYS=180
SPORTMONKS_API_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_TIMEOUT_SECONDS=20
SPORTMONKS_HISTORY_MATCHES=10
SPORTMONKS_LOOKBACK_DAYS=180
RESEARCH_IMPORT_TOKEN=
WEB_ORIGIN=http://localhost:3000
VISION_PROVIDER=demo
VISION_MODEL=gpt-5.6
OPENAI_API_KEY=
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=6

# Airtable reporting mirror (Postgres remains canonical; do not commit the token)
AIRTABLE_SYNC_ENABLED=false
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appWyZJjitSBATXAU
AIRTABLE_DECISION_STATES_TABLE=Decision States
AIRTABLE_TIMEOUT_SECONDS=15

# Web (server-side URL used by Next.js)
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
