{
  "id": "./",
  "name": "SlipTrace Football",
  "short_name": "SlipTrace",
  "description": "SlipTrace model board, live match context, official picks and alerts.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./#board",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#090b0f",
  "theme_color": "#090b0f",
  "categories": [
    "sports",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/sliptrace-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/sliptrace-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/sliptrace-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Decision Board",
      "short_name": "Board",
      "url": "./#board",
      "icons": [
        {
          "src": "./icons/sliptrace-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Picks",
      "short_name": "Picks",
      "url": "./#picks",
      "icons": [
        {
          "src": "./icons/sliptrace-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Explore",
      "short_name": "Explore",
      "url": "./#leagues",
      "icons": [
        {
          "src": "./icons/sliptrace-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
