{
  "id": "./",
  "name": "SlipTrace Football",
  "short_name": "SlipTrace",
  "description": "Football matchday, live scores, picks and SlipTrace model signals.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./#today",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#090b0f",
  "theme_color": "#090b0f",
  "categories": ["sports", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/sliptrace-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/sliptrace-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/sliptrace-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {"name": "Matchday", "short_name": "Matchday", "url": "./#today", "icons": [{"src": "./icons/sliptrace-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Model Board", "short_name": "Board", "url": "./#board", "icons": [{"src": "./icons/sliptrace-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Picks", "short_name": "Picks", "url": "./#picks", "icons": [{"src": "./icons/sliptrace-192.png", "sizes": "192x192", "type": "image/png"}]}
  ]
}
