{
  "id": "./",
  "name": "ARC XI",
  "short_name": "ARC XI",
  "description": "ARC XI live football and match intelligence with real-time scores, model signals, official picks and alerts.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./#board",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#08090d",
  "theme_color": "#08090d",
  "categories": [
    "sports",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/arc-xi-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/arc-xi-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/arc-xi-maskable-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Decision Board",
      "short_name": "Board",
      "url": "./#board",
      "icons": [
        {
          "src": "./icons/arc-xi-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Picks",
      "short_name": "Picks",
      "url": "./#picks",
      "icons": [
        {
          "src": "./icons/arc-xi-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Explore",
      "short_name": "Explore",
      "url": "./#leagues",
      "icons": [
        {
          "src": "./icons/arc-xi-192.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
